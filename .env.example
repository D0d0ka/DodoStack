# Main server configuration. Restart DodoStack after changing these values.
DODO_HOST=127.0.0.1
DODO_PORT=8000
DODO_PRIVATE=false
DODO_DEBUG=false

# Optional remote workspaces. IP=DNS-domain also opens the workspace on the DNS domain.
# DODO_WORKSPACE_HOSTS=dodoai,192.168.0.11=dodostack.home.arpa
# With an HTTP reverse proxy, specify the browser-facing port, e.g. dodo.ee:80.

# Optional. If blank, DodoStack uses the signing key in instance/server.key.
DODO_SECRET_KEY=

# Minimum length for new passwords.
DODO_MIN_PASSWORD_LENGTH=8
