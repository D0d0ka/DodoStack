# Copy this file to .env and adjust the values for your machine.

# --- Security ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, Dodo TV creates a development key in instance/.secret_key.
SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Defaults to instance/dodotv.db when unset.
# DATABASE_URL=sqlite:////absolute/path/to/dodotv.db

# --- Storage ----------------------------------------------------------------
# Defaults to ./uploads. Absolute paths are recommended in production.
# UPLOAD_FOLDER=/absolute/path/to/dodo_tv/uploads
MAX_UPLOAD_MB=4096
MAX_IMAGE_MB=20
MAX_SUBTITLE_MB=5
FRAME_COUNT=8
AUTO_INIT_DB=true

# --- FFmpeg -----------------------------------------------------------------
# Usually discovered automatically. Override if the binaries are elsewhere.
# FFMPEG_BINARY=/opt/homebrew/bin/ffmpeg
# FFPROBE_BINARY=/opt/homebrew/bin/ffprobe
FFMPEG_TIMEOUT=180

# --- Presentation -----------------------------------------------------------
SITE_NAME=Dodo TV
ITEMS_PER_PAGE=24
